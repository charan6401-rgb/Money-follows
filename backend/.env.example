# Placeholders only. Never commit real values (AGENTS.md section 3).
ENVIRONMENT=local
# Runtime role mf_app (never the migrator). Pooler URL; mode and parameters are UNVERIFIED until S0.
DATABASE_URL=postgresql+psycopg://mf_app:CHANGE_ME@localhost:5432/postgres
# Migrations only, from a trusted workstation. Never set this on the API host.
MIGRATION_DATABASE_URL=postgresql+psycopg://mf_migrator:CHANGE_ME@localhost:5432/postgres
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
LOG_LEVEL=INFO
# There is no SUPABASE_JWT_SECRET and no service-role key in V1.
