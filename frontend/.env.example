# Frontend build-time configuration. Names and placeholders only.
# Everything here ends up in the public browser bundle: NEVER put a secret,
# a database URL or a Supabase service-role key in any VITE_* variable.

# Base URL of the Money Follows API (no trailing slash, no /api/v1 suffix).
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and its public (publishable / anon) key. Auth only.
# The exact key name differs by project vintage (UNVERIFIED, see ARCHITECTURE.md section 11).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLIC_KEY=your-public-key-placeholder
